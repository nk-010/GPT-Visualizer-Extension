{
    "manifest_version": 3,
    "name": "GPT Visualizer Chrome extension",
    "version": "1.0.0",
    "description": "A Chrome extension built to visualize the chats in ChatGPT",
    "icons": {
        "16": "public/icons/icon16.png",
        "32": "public/icons/icon32.png",
        "48": "public/icons/icon48.png",
        "128": "public/icons/icon128.png"
    },
    "permissions": [
        "sidePanel",
        "tabs",
        "scripting"
    ],
    "action": {},
    "side_panel": {
        "default_path": "index.html"
    },
    "background": {
        "service_worker": "src/background/index.js",
        "type": "module"
    },
    "host_permissions": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/scripts/fetch.js"
            ],
            "matches": [
                "https://chat.openai.com/*",
                "https://chatgpt.com/*"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "https://chat.openai.com/*",
                "https://chatgpt.com/*"
            ],
            "js": [
                "src/content/index.js"
            ],
            "run_at": "document_start"
        }
    ]
}